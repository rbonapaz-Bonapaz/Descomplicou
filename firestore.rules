rules_version='2';service cloud.firestore{match /databases/{database}/documents{function signedIn(){return request.auth!=null;}function isOwner(uid){return signedIn()&&request.auth.uid==uid;}function isAdmin(){return signedIn()&&exists(/databases/$(database)/documents/users/$(request.auth.uid))&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='admin';}function donoPeloEvento(eventoId){return signedIn()&&exists(/databases/$(database)/documents/users/$(request.auth.uid)/eventos/$(eventoId));}match /users/{uid}{allow read:if isOwner(uid)||isAdmin();allow create:if isOwner(uid);allow update,delete:if isOwner(uid)||isAdmin();match /{collectionName}/{docId}{allow read,write:if isOwner(uid);}}match /config/{docId}{allow read:if signedIn();allow write:if isAdmin();}match /catalogoMestre/{docId}{allow read:if signedIn();allow write:if isAdmin();}match /sugestoesBeneficios/{docId}{allow create:if signedIn()&&request.resource.data.sugeridoPorUid==request.auth.uid&&request.resource.data.catalogoMestreId is string&&request.resource.data.beneficiosSugerido is string&&request.resource.data.beneficiosSugerido.size()>0&&request.resource.data.beneficiosSugerido.size()<2000&&request.resource.data.status=='pendente';allow read,update,delete:if isAdmin();}match /eventosPublicos/{eventoId}{allow read:if true;allow create:if signedIn()&&request.resource.data.uid==request.auth.uid;allow update,delete:if isOwner(resource.data.uid)||donoPeloEvento(eventoId)||isAdmin();match /listasDesejo/{listaId}{allow read:if signedIn()&&(get(/databases/$(database)/documents/eventosPublicos/$(eventoId)).data.uid==request.auth.uid||donoPeloEvento(eventoId));allow create:if request.resource.data.nomeVisitante is string&&request.resource.data.nomeVisitante.size()>0&&request.resource.data.nomeVisitante.size()<120&&request.resource.data.produtosDesejados is list&&request.resource.data.produtosDesejados.size()<100&&request.resource.data.produtosDesejados.size()>0;allow update,delete:if signedIn()&&(get(/databases/$(database)/documents/eventosPublicos/$(eventoId)).data.uid==request.auth.uid||donoPeloEvento(eventoId));}}}}
