# Copie para .env e preencha. O .env NUNCA vai para o git.

# --- Firebase (cliente) ---
# Estes valores são públicos por natureza: vão embutidos no bundle do navegador.
# A proteção dos dados NÃO vem daqui, vem do firestore.rules e dos custom claims.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Segredos de servidor ---
# Só existem nas Cloud Functions (firebase functions:secrets:set NOME).
# Se alguma destas aparecer com prefixo NEXT_PUBLIC_, ela vaza para o navegador.
# GEMINI_API_KEY   -> defina como secret da function, não aqui
# ASAAS_API_KEY    -> defina como secret da function, não aqui
# WEBHOOK_TOKEN    -> defina como secret da function, não aqui
