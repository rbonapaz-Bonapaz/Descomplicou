rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras de segurança para a Clínica Dra. Fabiula

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserProfile() {
      let path = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      return exists(path) ? get(path).data.perfil : 'visitante';
    }

    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || getUserProfile() == 'gestor');
    }

    match /catalogo_produtos/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (getUserProfile() == 'gestor' || getUserProfile() == 'secretaria');
    }

    match /logs_auditoria/{logId} {
      allow read: if isAuthenticated() && getUserProfile() == 'gestor';
      allow create: if isAuthenticated();
      allow update, delete: if false; // Imutável por definição
    }

    match /convenios/{convenioId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getUserProfile() == 'gestor';
    }

    match /feriados/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getUserProfile() == 'gestor';
    }

    match /pacientes/{patientId} {
      allow read: if isAuthenticated() && (getUserProfile() == 'gestor' || getUserProfile() == 'secretaria' || getUserProfile() == 'colaborador');
      allow write: if isAuthenticated() && (getUserProfile() == 'gestor' || getUserProfile() == 'secretaria');
    }

    match /agendamentos/{appointmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        getUserProfile() == 'gestor' || 
        getUserProfile() == 'secretaria' || 
        (getUserProfile() == 'colaborador' && request.auth.uid == (resource != null ? resource.data.profissional_id : request.resource.data.profissional_id))
      );
    }

    match /configuracoes/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getUserProfile() == 'gestor';
    }
    
    match /lancamentos_financeiros/{id} {
      allow read, write: if isAuthenticated() && getUserProfile() == 'gestor';
    }

    match /transacoes_financeiras/{id} {
      allow read, write: if isAuthenticated() && (getUserProfile() == 'gestor' || getUserProfile() == 'secretaria');
    }
    
    match /despesas_recorrentes/{id} {
      allow read, write: if isAuthenticated() && getUserProfile() == 'gestor';
    }
    
    match /fechamentos_mensais/{id} {
      allow read, write: if isAuthenticated() && getUserProfile() == 'gestor';
    }

    match /batidas_ponto/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /fechamentos_ponto/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getUserProfile() == 'gestor';
    }

    match /comunicados/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (getUserProfile() == 'gestor' || getUserProfile() == 'secretaria');
    }

    match /solicitacoes_ferias/{id} {
      allow read: if isAuthenticated() && (getUserProfile() == 'gestor' || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && getUserProfile() == 'gestor';
      allow delete: if false;
    }
  }
}
